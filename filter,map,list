        "# Check triangle inequality condition\n",
        "if (A + B > C) and (A + C > B) and (B + C > A):\n",
        "    perimeter = A + B + C\n",
        "    print(f\"Perimetro = {perimeter:.1f}\")\n",
        "else:\n",
        "    area = ((A + B) * C) / 2\n",
        "    print(f\"Area = {area:.1f}\")"
